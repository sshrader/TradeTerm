# Copy this file to ".env" and fill in your key. Never commit or share .env.
HELIUS_API_KEY=

# --- Optional tuning (defaults shown) ---
# PORT=8787
# HELIUS_MONTHLY_CREDITS=1000000   # your plan's monthly credits, used only for the meter in the UI
# RPC_MAX_RPS=8                    # stay under your plan's requests/second cap
# MAX_TOKENS=800                   # tokens kept in memory
# PARTIAL_MIN_SOL=0.5              # auto-track a token first seen mid-life only if a trade is at least this big

# --- Hosting (Railway or any server) ---
# HOST=0.0.0.0                     # default is 127.0.0.1 locally and 0.0.0.0 on Railway
# ACCESS_PASSWORD=                 # required when not on loopback; a random one is printed if unset
# DATA_DIR=/data                   # point at a mounted volume to keep your paper account

# --- Paper trading & risk limits ---
# PAPER_START_SOL=10
# MAX_POSITION_SOL=1               # max cost basis per token
# MAX_OPEN_POSITIONS=5
# DAILY_LOSS_CAP_SOL=2             # blocks new buys after this much realized loss in a day
# PAPER_SLIPPAGE_BPS=50            # pessimism added to every simulated fill
# PAPER_PRIORITY_FEE_SOL=0.001     # simulated priority fee + tip per transaction
